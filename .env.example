# GemmAid — Ortam Değişkenleri Şablonu
# Bu dosyayı .env olarak kopyalayıp doldurun: cp .env.example .env

# =============================================================
# BACKEND SEÇİMİ
# =============================================================
# local        → llama-cpp-python + Gemma 4 E4B GGUF (CPU, VARSAYILAN)
# transformers → HuggingFace Transformers pipeline (GPU/CPU, Kaggle)
# gemini       → Google AI API + Gemma 4 26B MoE (bulut)
GEMMAID_BACKEND=local

# =============================================================
# LOKAL MODEL (BACKEND=local — Birincil Backend)
# =============================================================
# Model indir: python scripts/download_model.py
# veya: bash deploy/setup.sh (otomatik indirir)
LOCAL_MODEL_PATH=./models/gemma-4-E4B-it-Q4_K_M.gguf

# llama.cpp thread sayısı (CPU çekirdek sayınıza göre ayarlayın)
# Intel CPU 8GB RAM → 4 thread önerilir
LOCAL_N_THREADS=4

# Context window boyutu
LOCAL_N_CTX=2048

# =============================================================
# GOOGLE AI API (BACKEND=gemini ise gerekli — opsiyonel)
# =============================================================
# https://aistudio.google.com adresinden alın
GEMINI_API_KEY=

# Gemma 4 modeli (Google AI Studio üzerinden)
# gemma-4-26b-a4b-it  → 26B MoE, güçlü (önerilen)
# gemma-4-31b-it      → 31B Dense, en güçlü
GEMINI_MODEL=gemma-4-26b-a4b-it

# =============================================================
# TELEGRAM BOT (Bot aktif edilecekse gerekli)
# =============================================================
# BotFather'dan: https://t.me/botfather → /newbot
# Detaylı rehber: docs/TELEGRAM_SETUP.md
TELEGRAM_TOKEN=

# =============================================================
# API & DASHBOARD
# =============================================================
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=7860

# =============================================================
# DATABASE
# =============================================================
DB_PATH=./gemmaid.db
